# WargaCare — Environment Variables
# Salin file ini ke .env dan isi dengan nilai yang sesuai
# JANGAN commit file .env ke git!

# ============================================================
# DATABASE (DDEV)
# Gunakan "ddev describe" untuk melihat port MariaDB dari host
# ============================================================
SPRING_DATASOURCE_URL=jdbc:mariadb://127.0.0.1:PORT/db
SPRING_DATASOURCE_USERNAME=db
SPRING_DATASOURCE_PASSWORD=db

# ============================================================
# JWT
# Ganti dengan secret yang kuat untuk production!
# Minimal 32 karakter (256-bit untuk HMAC-SHA256)
# ============================================================
JWT_SECRET=ganti-dengan-secret-yang-kuat-minimal-32-karakter
JWT_EXPIRATION=86400000

# ============================================================
# SERVER
# ============================================================
SERVER_PORT=8080
